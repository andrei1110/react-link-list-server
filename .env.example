# =================================================================
# App
# =================================================================
PORT=3000
NODE_ENV=development

# =================================================================
# JWT
# =================================================================
JWT_SECRET=super-secret-key
JWT_EXPIRES_IN=7d

# =================================================================
# Database - Neon (use a URL completa)
# =================================================================
DATABASE_URL=postgres://user:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Caso prefira configurar manualmente:
# DB_HOST=ep-xxxxx.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_USER=user
# DB_PASSWORD=password
# DB_NAME=neondb
